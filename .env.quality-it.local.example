# Local-only disposable smoke stack. Copy to .env.quality-it.local; do not commit secrets.
QUALITY_IT_RUN_ID=local-dev
QUALITY_IT_BUCKET=ecommerce-quality-it
# Reuse the existing local MinIO container published by the root compose stack.
QUALITY_IT_MINIO_ENDPOINT=host.docker.internal:9000
QUALITY_IT_MINIO_ACCESS_KEY=qualityitadmin
QUALITY_IT_MINIO_SECRET_KEY=qualityitadmin-local-only
QUALITY_IT_NESSIE_PORT=19130
# Root Airflow local-only native Gold configuration. Do not copy secrets here.
BRONZE_BUCKET=ecommerce-quality-it
INGESTION_WRITE_ENABLED=true
AIRFLOW_LOCAL_E2E_MODE=WRITE
LAKEHOUSE_WRITE_ENABLED=true
GOLD_DIMENSIONAL_ENABLED=true
GOLD_DIMENSIONAL_WRITE_ENABLED=false
GOLD_DIM_DATE_START=2026-01-01
GOLD_DIM_DATE_END=2026-01-07
CUSTOMERS_SILVER_SOURCE=iceberg
PRODUCTS_SILVER_SOURCE=iceberg
ORDERS_SILVER_SOURCE=iceberg
ORDER_ITEMS_SILVER_SOURCE=iceberg
PAYMENTS_SILVER_SOURCE=iceberg
SHIPMENTS_SILVER_SOURCE=iceberg
NESSIE_URI=http://nessie:19120/api/v2
NESSIE_REF=main
