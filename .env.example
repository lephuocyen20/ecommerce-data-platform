DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_platform
DB_USER=ecommerce_user
DB_PASSWORD=ecommerce_pass

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
BRONZE_BUCKET=ecommerce-data-lake

# All data-changing pipeline stages are disabled by default. Enable each flag
# explicitly only for a reviewed WRITE run.
INGESTION_WRITE_ENABLED=false
WAREHOUSE_WRITE_ENABLED=false

# Enables immutable Silver snapshot creation and Gold snapshot publication
# after a successful incremental WRITE.
GOLD_SNAPSHOT_WRITE_ENABLED=false

# Absolute host path mounted by Airflow's DockerOperator.  Docker Desktop on
# Windows needs a host-visible absolute path, for example:
# AIRFLOW_DOCKER_PROJECT_PATH=C:/Users/you/Projects/ecommerce-data-platform
# Leave unset when Docker Compose can derive it from the current directory.
# AIRFLOW_DOCKER_PROJECT_PATH=

# Optional DockerOperator overrides.  Defaults match the local Compose stack.
# AIRFLOW_DOCKER_NETWORK=ecommerce-data-platform_default
# SPARK_IMAGE=ecommerce-spark:3.5.6
# DBT_RUNNER_IMAGE=ecommerce-data-platform-dbt-runner:latest

AIRFLOW_DB_USER=ecommerce_user
AIRFLOW_DB_PASSWORD=ecommerce_pass
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_HOST=postgres
AIRFLOW_DB_PORT=5432
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
# Change this value in your local .env before starting Airflow.
AIRFLOW_ADMIN_PASSWORD=change_this_local_password

AIRFLOW_API_SECRET_KEY=replace_with_random_secret
AIRFLOW_JWT_SECRET=replace_with_random_secret
MINIO_ROOT_PASSWORD=replace_with_secure_password
MINIO_ROOT_USER=minioadmin
POSTGRES_PASSWORD=replace_with_secure_password
