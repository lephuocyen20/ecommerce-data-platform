DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=ecommerce_user
DB_PASSWORD=ecommerce_pass

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
BRONZE_BUCKET=ecommerce-data-lake

# Enables immutable Silver snapshot creation after a successful incremental WRITE.
# Gold transformation remains read-only until Gold publication is implemented.
GOLD_SNAPSHOT_WRITE_ENABLED=false

AIRFLOW_DB_USER=ecommerce_user
AIRFLOW_DB_PASSWORD=ecommerce_pass
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_HOST=postgres
AIRFLOW_DB_PORT=5432
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
# Change this value in your local .env before starting Airflow.
AIRFLOW_ADMIN_PASSWORD=change_this_local_password

AIRFLOW_API_SECRET_KEY=replace_with_random_secret
AIRFLOW_JWT_SECRET=replace_with_random_secret
MINIO_ROOT_PASSWORD=replace_with_secure_password
MINIO_ROOT_USER=minioadmin
POSTGRES_PASSWORD=replace_with_secure_password
